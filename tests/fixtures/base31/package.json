{
  "name": "mission-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Local orchestrator + dashboard for teams of headless Claude agents across project workspaces",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "server:start": "bin/server.sh start",
    "server:stop": "bin/server.sh stop",
    "server:restart": "bin/server.sh restart",
    "server:status": "bin/server.sh status"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.3.0",
    "tsx": "^4.19.0",
    "ws": "^8.21.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
